# Placeholder keys for local development. Keep real values OUT of this repo:
# either export MODEL_API_KEY in your shell, or keep them in a file outside
# the repo (e.g. ~/.config/refi/env) and export from there —
#   set -a; source ~/.config/refi/env; set +a
# then run the app from this directory:
#   streamlit run app.py
# `.env` is gitignored and MUST never be committed. This file holds
# no real secrets. The app never reads any env file itself: the key must be
# in the environment (or deploy secrets) before Streamlit starts.
#
# Key owners (see AGENTS.md section 7 for credit status):
# - MODEL_API_KEY: Meta Model API (primary inference).
# - BASETEN_API_KEY: Baseten (claim judge, plan Stage 3).
# - MODAL_TOKEN_ID / MODAL_TOKEN_SECRET: Modal (batch eval, plan Stage 3).
# - FIREWORKS_API_KEY: Fireworks (reserved fine-tune path, last priority).

MODEL_API_KEY=

BASETEN_API_KEY=

MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

FIREWORKS_API_KEY=
